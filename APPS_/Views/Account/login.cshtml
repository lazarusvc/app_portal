@model Apps_.Models.LoginViewModel

@{ ViewBag.Title = "Log in"; }

<div class="row rowlogin">
    <div class="login col-md-8">
        <section id="loginForm">
            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "logForm", role = "form" }))
            {@Html.AntiForgeryToken()
            <h1>Login</h1>
            <p>Use your account information provided to log in.</p>
            <hr /> @Html.ValidationSummary(true)
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.EditorFor(m => m.UserName, new { htmlAttributes = new { data_role = "input", data_prepend = "User Name: ", @placeholder = "e.g. doej" } })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "fg-magenta" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.EditorFor(m => m.Password, new { htmlAttributes = new { data_role = "input", data_prepend = "Password: ", @placeholder = "******" } })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "fg-magenta" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-4 col-md-8">
                        <div class="checkbox">
                            @Html.CheckBoxFor(m => m.RememberMe) @Html.LabelFor(m => m.RememberMe)
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12 loginBtn">
                        <input type="submit" value="Log in" class="button default" />
                    </div>
                </div>
        }
        </section>
    </div>
</div>

