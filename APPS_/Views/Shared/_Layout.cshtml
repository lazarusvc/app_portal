<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - @Apps_.Controllers.HomeController.global_Identity(1)</title>
    @Styles.Render("~/Content/metro")
    @Scripts.Render("~/bundles/modernizr")

    <link href="https://fonts.googleapis.com/css2?family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
</head>

<body class="cloak h-100-vh">
    <nav data-role="appbar" class="border-bottom bd-default" data-expand="true">
        <button id="sidebar-toggle"><span class="mif-menu"></span></button>
        <div class="app-bar-item-static no-hover">
            <div class="text-leader">
                <a href="@Url.Action("Index","Home")" class="brand no-hover">
                    <span class="mif-apps mif-3x" style="margin-right:10px;"></span> Apps Home | ver: @ViewContext.Controller.GetType().Assembly.GetName().Version.ToString()
                </a>
            </div>
        </div>
    </nav>
    <div class="container-fluid h-100">
        <aside class="pos-absolute h-100" data-role="sidebar" data-shift="#content" data-toggle="#sidebar-toggle" id="sb1">
            <div class="sidebar-header">
                <span class="action" onclick="Metro.sidebar.close('#sb1'); return false;"><span class="mif-arrow-left mif-2x"></span></span>
                <div class="avatar">
                    <img data-role="gravatar" data-email="@Apps_.Controllers.HomeController.global_Identity(7)" alt="" />
                </div>
                <span class="title">APPS Portal</span>
                <span class="subtitle">Sys-Admin's Frontpage</span>
            </div>
            <ul class="sidebar-menu">
                <li class="group-title">Start</li>
                <li><a href="~/Home/About"><span class="mif-cast"></span> About</a></li>
                <li><a href="~/Home/Contact"><span class="mif-dialpad"></span> Contact</a></li>
                <li><a href="~/Account/Login"><span class="mif-user"></span> Login</a></li>
                @if (Request.IsAuthenticated)
                {
                    <li class="group-title"><span class="mif-user"></span> signed in as - @User.Identity.Name!</li>
                    <li>@Html.ActionLink("Sign Out", "LogOff", "Account")</li>
                }
                <li class="group-title">Settings</li>
                <li><a href="~/Identities"><span class="mif-cog"></span> Identity</a></li>
                <li><a href="~/Apps"><span class="mif-cog"></span> Apps</a></li>
                <li><a href="~/Apps_Type"><span class="mif-cog"></span> Apps Type</a></li>
                <li><a href="~/Apps_Category"><span class="mif-cog"></span> Apps Category</a></li>
                <li><a href="~/Apps_Document"><span class="mif-cog"></span> Document</a></li>
                <li><a href="~/Apps_Users"><span class="mif-cog"></span> Users</a></li>
                <li><a href="~/Apps_UsersRole"><span class="mif-cog"></span> User Roles</a></li>
                <li><a href="~/Apps_reports"><span class="mif-cog"></span> Reports</a></li>
                <li><a href="~/Apps_reports_params"><span class="mif-cog"></span> Reports Parameter</a></li>
                <li><a href="~/Apps_REF_processes"><span class="mif-cog"></span> Processes Parameter</a></li>
            </ul>
        </aside>

        <div class="content" id="content">
            <br/>
            <br/>
            @RenderBody()
        </div>
    </div>
</body>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/metro")
@RenderSection("scripts", required: false)

</html>
